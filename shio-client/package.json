{
  "name": "@viglet/shio-client",
  "version": "2026.3.2",
  "description": "Framework-agnostic TypeScript client for the Viglet Shio Content Delivery API (CDA). Zero runtime dependencies — works in Node, the browser, edge runtimes, Next.js server components, Astro, Vue, Svelte and plain scripts.",
  "homepage": "https://shio.viglet.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git",
    "directory": "shio-client"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "type": "module",
  "main": "dist/shio-client.umd.cjs",
  "module": "dist/shio-client.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shio-client.js",
      "require": "./dist/shio-client.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "shio-types": "bin/shio-types.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../scripts/test-watchdog.mjs --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  },
  "keywords": [
    "shio",
    "viglet",
    "cms",
    "headless-cms",
    "content-management-system",
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cda",
    "content-delivery",
    "typescript",
    "sdk",
    "api-client",
    "nextjs",
    "astro",
    "edge",
    "headless"
  ],
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  },
  "license": "Apache-2.0"
}
