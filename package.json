{
  "name": "@viglet/shio-js",
  "private": true,
  "version": "2026.2.0",
  "description": "Shio CMS JavaScript workspace — console (shio-react), CDA client, React SDK and the Next.js starter generator.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "pnpm --filter @viglet/shio-client run build",
    "build:sdk": "pnpm --filter @viglet/shio-client run build && pnpm --filter @viglet/shio-react-sdk run build",
    "build:console": "pnpm --filter shio-react run compile:build",
    "typecheck": "pnpm --filter @viglet/shio-client --filter @viglet/shio-react-sdk run typecheck",
    "test": "pnpm --filter @viglet/shio-client --filter create-shio-app run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "license": "GPL-3.0"
}
