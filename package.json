{
  "name": "@viglet/shio-js",
  "private": true,
  "version": "2026.3.2",
  "description": "Viglet Shio JavaScript workspace \u2014 console (shio-react), CDA client, React SDK, the page-section vocabulary, Universal Editor bridge, the Next.js starter generator and the example sites.",
  "homepage": "https://openviglet.github.io/shio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11",
    "npm": ">=11"
  },
  "scripts": {
    "build:client": "pnpm --filter @viglet/shio-client run build",
    "build:sdk": "pnpm --filter @viglet/shio-client run build && pnpm --filter @viglet/shio-react-sdk run build",
    "build:sections": "pnpm --filter @viglet/shio-model run build && pnpm --filter @viglet/shio-sections run build",
    "build:editor": "pnpm --filter @viglet/shio-editor-cors run build",
    "build:console": "pnpm --filter shio-react run compile:build",
    "build:examples": "pnpm --filter blog-site --filter corporate-site run build",
    "build": "pnpm run build:sdk && pnpm run build:sections && pnpm run build:editor && pnpm run build:console && pnpm run build:examples",
    "build:site": "pnpm --filter shio-site run build",
    "dev:console": "pnpm --filter shio-react run dev",
    "dev:site": "pnpm --filter shio-site run dev",
    "typecheck": "pnpm --filter @viglet/shio-client --filter @viglet/shio-react-sdk --filter @viglet/shio-sections --filter shio-site run typecheck",
    "lint": "pnpm -r run lint",
    "test": "node scripts/run-gate.mjs js",
    "test:raw": "pnpm --filter @viglet/shio-client --filter @viglet/shio-model --filter @viglet/shio-sections --filter @viglet/create-shio-app --filter @viglet/shio --filter @viglet/shio-claude-plugin --filter shio-react --filter shio-site run test",
    "coverage:mirror": "node scripts/coverage-mirror.mjs",
    "deps": "node scripts/dependency-reachability.mjs --all",
    "flake": "node scripts/flake.mjs",
    "java": "node scripts/run-gate.mjs java",
    "conformance": "node scripts/run-gate.mjs conformance",
    "conformance:raw": "pnpm --filter @viglet/shio run conformance",
    "conformance:docs": "node scripts/run-gate.mjs docs",
    "gates": "node scripts/gates-report.mjs",
    "gates:clear": "node scripts/gates-clear.mjs",
    "look": "node scripts/look-census.mjs",
    "clean": "rimraf \"**/node_modules\" \"**/dist\" \"**/build\""
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.0.1"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  }
}
