---
/**
 * Starlight's own head, plus a BreadcrumbList, so the result's breadcrumb reads
 * Shio › Docs › page rather than whatever Google derives from the URL.
 */
import Default from "@astrojs/starlight/components/Head.astro";

const SITE = "https://shio.viglet.org";
const docsHome = `${SITE}${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`;
const url = new URL(Astro.url.pathname, SITE).href;
const items = [
  { name: "Shio", item: `${SITE}/` },
  { name: "Docs", item: docsHome },
];
if (url !== docsHome) items.push({ name: Astro.locals.starlightRoute.entry.data.title, item: url });

const breadcrumbs = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((it, i) => ({ "@type": "ListItem", position: i + 1, ...it })),
}).replace(/</g, "\\u003c");
---

<Default />
<script is:inline type="application/ld+json" set:html={breadcrumbs} />
