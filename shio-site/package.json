{
  "name": "shio-site",
  "private": true,
  "version": "2026.3.2",
  "type": "module",
  "description": "Public site of Viglet Shio (shio.viglet.org), the open-source, agent-ready CMS with four ways in: console, coding agent, files and delivery API.",
  "homepage": "https://shio.viglet.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git",
    "directory": "shio-site"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node scripts/token-budgets.mjs && node scripts/marketplace.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/og-image.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "node --import ../scripts/test-watchdog.mjs --test scripts/*.test.mjs",
    "budgets": "node scripts/token-budgets.mjs",
    "marketplace": "node scripts/marketplace.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  },
  "keywords": [
    "shio",
    "viglet",
    "cms",
    "headless-cms",
    "content-management-system",
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "website",
    "vite",
    "react"
  ],
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  }
}
