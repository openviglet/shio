# pnpm settings for the Shio frontend workspace.

# Hoist every transitive dep to the top-level node_modules so code that relies
# on phantom imports keeps working, and (more importantly) so platform-specific
# optional natives resolve correctly — esbuild / @tailwindcss/oxide / rolldown
# binaries on Linux CI, etc. Loses pnpm's strictness but preserves the main
# benefit of the workspace move.
shamefully-hoist=true

# CI/builds should never block on a missing/loose engines entry. Keep 'engines'
# advisory only.
engine-strict=false
