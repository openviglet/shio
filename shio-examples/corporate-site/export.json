      "fields": {
        "TITLE": "Welcome to Viglet",
        "SUBTITLE": "Building the future of content management",
        "HERO_IMAGE": "https://images.unsplash.com/photo-1497366216548-37526070297c?w=1200&h=600&fit=crop",
        "BODY": "<p>Viglet is a modern content management platform that empowers teams to create, manage, and deliver exceptional digital experiences. Our platform combines powerful content modeling with an intuitive visual editor.</p><p>With our Universal Editor, content authors can edit directly on the rendered page, seeing changes in real-time without switching between a form-based backend and the live site.</p>",
        "CTA_TEXT": "Get Started",
        "CTA_URL": "/services"
      }
    },
    {
      "id": "d1e2f3a4-0001-4000-d000-000000000002",
      "date": "2026-04-11T00:00Z",
      "owner": "admin",
      "furl": "about",
