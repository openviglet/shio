{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task",
      "Agent",
      "Skill",
      "SlashCommand",
      "Artifact",
      "Workflow",
      "Monitor",
      "BashOutput",
      "KillShell",
      "KillBash",
      "ToolSearch",
      "SendMessage",
      "TaskOutput",
      "TaskStop",
      "ScheduleWakeup",
      "CronCreate",
      "CronList",
      "CronDelete",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "DesignSync",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ShareOnboardingGuide",
      "mcp__plugin_roadkeep_roadkeep",
      "mcp__roadkeep"
    ],
    "deny": [],
    "ask": [],
    "additionalDirectories": [
      "D:\\Git\\viglet\\shio",
      "D:\\Git\\viglet\\shio\\latest",
      "D:\\Git\\viglet\\turing\\latest",
      "D:\\Git\\viglet\\turing\\2026.3",
      "D:\\Git\\viglet\\vigletdocs\\vigletdocs.github.io",
      "D:\\Git\\viglet\\openviglet.github.io",
      "D:\\Git\\viglet\\viglet-design-system",
      "D:\\Dev\\bin",
      "D:\\tmp",
      "C:\\Users\\alexa\\AppData\\Local\\Temp\\claude"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "roadkeep@alegauss": true
  },
  "extraKnownMarketplaces": {
    "alegauss": {
      "source": {
        "source": "github",
        "repo": "alegauss/roadkeep"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/roadkeep-launch.py\" guard",
            "timeout": 70
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/roadkeep-launch.py\" guard",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/roadkeep-launch.py\" guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
