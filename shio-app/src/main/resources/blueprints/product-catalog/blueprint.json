{
  "formatVersion": 1,
  "name": "product-catalog",
  "title": "Product catalogue",
  "version": "1.0.0",
  "description": "A Product post-type with SKU, price and a repeatable spec list, plus /products with an accessories subsection and three sample products.",
  "params": {
    "type": "object",
    "properties": {
      "storeName": {
        "type": "string",
        "description": "The store's name, used in the sample copy.",
        "default": "Store"
      },
      "currency": {
        "type": "string",
        "description": "Currency code the sample products are priced in.",
        "default": "USD",
        "enum": [
          "USD",
          "EUR",
          "BRL"
        ]
      },
      "projectName": {
        "type": "string",
        "description": "The npm package name of the generated project. Used in the front-end tree this package carries.",
        "default": "my-shio-site"
      }
    }
  },
  "postTypes": [
    "post-types/Product.json"
  ],
  "content": [
    "content/catalog.json"
  ],
  "verify": {
    "posts": [
      "/products/starter-kit",
      "/products/pro-kit",
      "/products/accessories/carry-case"
    ],
    "checks": "content"
  },
  "files": [
    {
      "path": ".env.example",
      "from": "files/env.example"
    },
    {
      "path": ".gitignore",
      "from": "files/gitignore"
    },
    {
      "path": "app/[...slug]/page.tsx",
      "from": "files/app/[...slug]/page.tsx"
    },
    {
      "path": "app/api/preview/route.ts",
      "from": "files/app/api/preview/route.ts"
    },
    {
      "path": "app/api/revalidate/route.ts",
      "from": "files/app/api/revalidate/route.ts"
    },
    {
      "path": "app/layout.tsx",
      "from": "files/app/layout.tsx"
    },
    {
      "path": "app/page.tsx",
      "from": "files/app/page.tsx"
    },
    {
      "path": "app/products/page.tsx",
      "from": "files/app/products/page.tsx"
    },
    {
      "path": "lib/redirects.ts",
      "from": "files/lib/redirects.ts"
    },
    {
      "path": "lib/shio.ts",
      "from": "files/lib/shio.ts"
    },
    {
      "path": "middleware.ts",
      "from": "files/middleware.ts"
    },
    {
      "path": "next-env.d.ts",
      "from": "files/next-env.d.ts"
    },
    {
      "path": "next.config.mjs",
      "from": "files/next.config.mjs"
    },
    {
      "path": "package.json",
      "from": "files/package.json"
    },
    {
      "path": "README.md",
      "from": "files/README.md"
    },
    {
      "path": "tsconfig.json",
      "from": "files/tsconfig.json"
    }
  ]
}
