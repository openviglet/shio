# Shio Content Delivery API connection
SHIO_URL=http://localhost:2710
SHIO_SITE_ID=
# PROD-env CDA token (serves PUBLISHED content)
SHIO_CDA_TOKEN=

# --- Optional: draft preview (SH9) ---
# PREVIEW-env CDA token (serves draft-preferred content). Leave empty to disable.
SHIO_PREVIEW_TOKEN=
# Secret that gates the /api/preview entry point.
SHIO_PREVIEW_SECRET=

# --- Optional: on-demand revalidation (SH9) ---
# Shared secret the publish webhook signs its body with (HMAC-SHA256).
SHIO_WEBHOOK_SECRET=
