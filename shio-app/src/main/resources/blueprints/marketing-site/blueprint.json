{
  "formatVersion": 1,
  "name": "marketing-site",
  "title": "Marketing site",
  "version": "1.0.0",
  "description": "A three-page marketing site built from the @viglet/shio-sections vocabulary: home, pricing and about, each composed of known sections (hero, feature grid, logo wall, testimonials, FAQ, call to action). The React components that render these sections ship in @viglet/shio-sections, so the front end is a dependency rather than a rewrite.",
  "params": {
    "type": "object",
    "required": [
      "brand"
    ],
    "properties": {
      "brand": {
        "type": "string",
        "description": "The company or product name. Appears in every heading, so there is no useful default."
      },
      "tagline": {
        "type": "string",
        "description": "One line under the hero heading.",
        "default": "Software that gets out of the way"
      },
      "ctaLabel": {
        "type": "string",
        "description": "Label on the primary call to action.",
        "default": "Talk to us"
      },
      "ctaHref": {
        "type": "string",
        "description": "Where the primary call to action points.",
        "default": "/contact"
      },
      "projectName": {
        "type": "string",
        "description": "The npm package name of the generated project. Used in the front-end tree this package carries.",
        "default": "my-shio-site"
      }
    }
  },
  "postTypes": [
    "post-types/Page.json",
    "post-types/Menu.json",
    "post-types/MenuItem.json",
    "post-types/SectionCta.json",
    "post-types/SectionFaq.json",
    "post-types/SectionFeatureGrid.json",
    "post-types/SectionHero.json",
    "post-types/SectionLogoWall.json",
    "post-types/SectionMarkup.json",
    "post-types/SectionRichText.json",
    "post-types/SectionTestimonial.json"
  ],
  "content": [
    "content/sections.json",
    "content/pages.json"
  ],
  "verify": {
    "posts": [
      "/",
      "/pricing",
      "/about"
    ],
    "checks": "content"
  },
  "files": [
    {
      "path": ".env.example",
      "from": "files/env.example"
    },
    {
      "path": ".gitignore",
      "from": "files/gitignore"
    },
    {
      "path": "app/[...slug]/page.tsx",
      "from": "files/app/[...slug]/page.tsx"
    },
    {
      "path": "app/api/preview/route.ts",
      "from": "files/app/api/preview/route.ts"
    },
    {
      "path": "app/api/revalidate/route.ts",
      "from": "files/app/api/revalidate/route.ts"
    },
    {
      "path": "app/layout.tsx",
      "from": "files/app/layout.tsx"
    },
    {
      "path": "app/page.tsx",
      "from": "files/app/page.tsx"
    },
    {
      "path": "lib/sections.ts",
      "from": "files/lib/sections.ts"
    },
    {
      "path": "lib/shio.ts",
      "from": "files/lib/shio.ts"
    },
    {
      "path": "next-env.d.ts",
      "from": "files/next-env.d.ts"
    },
    {
      "path": "next.config.mjs",
      "from": "files/next.config.mjs"
    },
    {
      "path": "package.json",
      "from": "files/package.json"
    },
    {
      "path": "README.md",
      "from": "files/README.md"
    },
    {
      "path": "tsconfig.json",
      "from": "files/tsconfig.json"
    }
  ]
}
