{
  "formatVersion": 1,
  "name": "docs",
  "title": "Documentation",
  "version": "1.0.0",
  "description": "A documentation tree: a DocPage post-type, /docs with guides and reference sections, and four pages wired together — an index, two guides and one reference page.",
  "params": {
    "type": "object",
    "required": [
      "productName"
    ],
    "properties": {
      "productName": {
        "type": "string",
        "description": "What the documentation is about. It has no sensible default."
      },
      "projectName": {
        "type": "string",
        "description": "The npm package name of the generated project. Used in the front-end tree this package carries.",
        "default": "my-shio-site"
      }
    }
  },
  "postTypes": [
    "post-types/DocPage.json"
  ],
  "content": [
    "content/docs.json"
  ],
  "verify": {
    "posts": [
      "/docs",
      "/docs/guides/getting-started",
      "/docs/guides/configuration",
      "/docs/reference/api"
    ],
    "checks": "content,routes"
  },
  "files": [
    {
      "path": ".env.example",
      "from": "files/env.example"
    },
    {
      "path": ".gitignore",
      "from": "files/gitignore"
    },
    {
      "path": "app/[...slug]/page.tsx",
      "from": "files/app/[...slug]/page.tsx"
    },
    {
      "path": "app/api/preview/route.ts",
      "from": "files/app/api/preview/route.ts"
    },
    {
      "path": "app/api/revalidate/route.ts",
      "from": "files/app/api/revalidate/route.ts"
    },
    {
      "path": "app/docs/page.tsx",
      "from": "files/app/docs/page.tsx"
    },
    {
      "path": "app/layout.tsx",
      "from": "files/app/layout.tsx"
    },
    {
      "path": "app/page.tsx",
      "from": "files/app/page.tsx"
    },
    {
      "path": "lib/redirects.ts",
      "from": "files/lib/redirects.ts"
    },
    {
      "path": "lib/shio.ts",
      "from": "files/lib/shio.ts"
    },
    {
      "path": "middleware.ts",
      "from": "files/middleware.ts"
    },
    {
      "path": "next-env.d.ts",
      "from": "files/next-env.d.ts"
    },
    {
      "path": "next.config.mjs",
      "from": "files/next.config.mjs"
    },
    {
      "path": "package.json",
      "from": "files/package.json"
    },
    {
      "path": "README.md",
      "from": "files/README.md"
    },
    {
      "path": "tsconfig.json",
      "from": "files/tsconfig.json"
    }
  ]
}
