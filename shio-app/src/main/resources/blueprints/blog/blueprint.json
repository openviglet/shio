{
  "formatVersion": 1,
  "name": "blog",
  "title": "Blog",
  "version": "1.0.0",
  "description": "An Article post-type, a /blog folder and three published sample posts. The starting point for anything with a feed: the model is the part that is tedious to get right, and the samples show the field usage a later session should match.",
  "params": {
    "type": "object",
    "properties": {
      "blogTitle": {
        "type": "string",
        "description": "The blog's name, used in the sample copy.",
        "default": "Blog"
      },
      "authorName": {
        "type": "string",
        "description": "Byline on the sample posts.",
        "default": "Editorial"
      },
      "projectName": {
        "type": "string",
        "description": "The npm package name of the generated project. Used in the front-end tree this package carries.",
        "default": "my-shio-site"
      }
    }
  },
  "postTypes": [
    "post-types/Article.json"
  ],
  "content": [
    "content/blog.json"
  ],
  "verify": {
    "posts": [
      "/blog/hello-world",
      "/blog/how-we-work",
      "/blog/whats-next"
    ],
    "checks": "content"
  },
  "files": [
    {
      "path": ".env.example",
      "from": "files/env.example"
    },
    {
      "path": ".gitignore",
      "from": "files/gitignore"
    },
    {
      "path": "app/[...slug]/page.tsx",
      "from": "files/app/[...slug]/page.tsx"
    },
    {
      "path": "app/api/preview/route.ts",
      "from": "files/app/api/preview/route.ts"
    },
    {
      "path": "app/api/revalidate/route.ts",
      "from": "files/app/api/revalidate/route.ts"
    },
    {
      "path": "app/blog/page.tsx",
      "from": "files/app/blog/page.tsx"
    },
    {
      "path": "app/layout.tsx",
      "from": "files/app/layout.tsx"
    },
    {
      "path": "app/page.tsx",
      "from": "files/app/page.tsx"
    },
    {
      "path": "lib/shio.ts",
      "from": "files/lib/shio.ts"
    },
    {
      "path": "next-env.d.ts",
      "from": "files/next-env.d.ts"
    },
    {
      "path": "next.config.mjs",
      "from": "files/next.config.mjs"
    },
    {
      "path": "package.json",
      "from": "files/package.json"
    },
    {
      "path": "README.md",
      "from": "files/README.md"
    },
    {
      "path": "tsconfig.json",
      "from": "files/tsconfig.json"
    }
  ]
}
