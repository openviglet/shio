    <build>
        <finalName>viglet-shio</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- SH271 — say which API, not "recompile for details". javac reported a
                             deprecated call in one test file and then withheld the name of the
                             method, which is a warning that costs a second build to read and
                             therefore does not get read. It was `textNode`, renamed by Jackson 3;
                             with this on, the next one names itself the first time. -->
                        <showDeprecation>true</showDeprecation>
                        <!-- Pin Lombok as an annotation processor explicitly.
                             Newer javac (JDK 23+) no longer auto-discovers
                             processors from the classpath, which silently
                             dropped every Lombok-generated getter/setter in
                             Docker builds on newer JDKs. -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.48</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Force a full resource copy. The React build (frontend-maven-plugin,
                 generate-resources) regenerates src/main/resources/public/index.html
                 in the same invocation; maven-resources' incremental copy otherwise
                 skips that stable-named file (while copying the freshly-hashed
                 assets/*), so index.html never reaches target/classes/public and the
                 SPA 404s at runtime and in the packaged jar. changeDetection=always
                 disables the staleness check so index.html is always copied; it is
                 the plugin's own spelling of the old overwrite=true (deprecated in
                 3.5.0, "Equivalent of overwrite=true" per its descriptor). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <!-- Pinned at the version Maven 3.9.9 was already binding (SH271). Unversioned, it
                     was the one thing in this build Maven itself called malformed, on every run:
                     "future Maven versions might no longer support building such malformed
                     projects". Pinned to what runs today rather than to the newest, because the
                     `overwrite` behaviour below is load-bearing and an upgrade is its own decision. -->
                <version>3.5.0</version>
                <configuration>
                    <changeDetection>always</changeDetection>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <executions>
                    <execution>
                        <id>react install node and pnpm</id>
                        <goals>
                            <goal>install-node-and-pnpm</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>../shio-react</workingDirectory>
                        </configuration>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>react install workspace deps (pnpm)</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <!-- Run from the console package; pnpm finds the
                                 workspace root (../) and installs all members. -->
                            <arguments>install</arguments>
                            <workingDirectory>../shio-react</workingDirectory>
                        </configuration>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>react compile</id>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <!-- Deps already installed above; build only. -->
                            <arguments>run compile:build</arguments>
                            <workingDirectory>../shio-react</workingDirectory>
                        </configuration>
                        <phase>generate-resources</phase>
                    </execution>
                </executions>
                <configuration>
                    <nodeVersion>v26.3.1</nodeVersion>
                    <pnpmVersion>11.8.0</pnpmVersion>
                    <skip>${skip.npm}</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SH250 — resolves each dependency's path into a property so the Mockito jar can be
                 named as a `-javaagent` below. `${org.mockito:mockito-core:jar}` is this plugin's
                 output; without it the agent path would have to be hard-coded against the local
                 repository layout, which differs per machine and per Maven version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <!-- Pinned at what Maven 3.9.9 was already binding (SH271). Maven never warned about
                     this one — only about maven-resources-plugin — so it took its version from the
                     wrapper's distribution silently, on the path SH250's `-javaagent` argLine depends
                     on. Found by the lint that turned that warning into a build failure. -->
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- SH250 — Mockito as a real agent instead of self-attaching.
                         The suite printed this on every run: "Mockito is currently self-attaching
                         to enable the inline-mock-maker. This will no longer work in future
                         releases of the JDK." Two problems stacked: instrumentation installed by
                         attaching to the *running* JVM succeeds or fails depending on what has
                         already been loaded — which is why ShTenantSuspendedAccessTest failed six
                         of six once during Block P and passed on every re-run, in isolation and in
                         the full suite — and the JDK is removing dynamic agent loading, so the
                         intermittent failure becomes permanent. A flaky suite is more expensive
                         than a broken one: it teaches everybody that a red run might mean nothing,
                         which is how a real regression gets a re-run instead of an investigation.
                         `@{argLine}` (late replacement) rather than `${argLine}` so a future
                         JaCoCo argLine is appended to, not overwritten. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <!-- SH414 — four JVMs, because SH317 priced the *count* of isolated contexts and this
                         is the other half of the same bill: it does not remove a boot, it stops the
                         boots waiting for each other. SH317 measured ~1.5 s per isolated context and
                         36 of them, and closed "share a context but not a database" — the datasource
                         URL is part of the cache key, so two URLs are two contexts by construction.
                         What was left was to run them concurrently.

                         Measured on the surefire phase, not the Maven total, for SH283's reason one
                         level along — the total carries ~18 s of compile and SH317 recorded ±20 s of
                         noise in it, which is wide enough to hide the whole win:

                           forkCount=1   91.8 s  (n=2, 87.4–96.1)
                           forkCount=4   68.4 s  (n=3, 68.1–68.6)   <- here
                           forkCount=8   77.4 s  (n=1)

                         Eight is *slower* than four on a 28-core machine, which is the finding worth
                         keeping: the work being parallelised is 36 Spring boots contending for one
                         H2 process image and one CPU cache, not 176 independent test classes, so the
                         curve turns back up well before the core count. Do not raise this to `1C`
                         and assume it scales.

                         Also less noisy, not just faster: three runs at four forks landed inside
                         0.5 s of each other against a 9 s spread at one. That matters more than the
                         23 s — SH250's rule is that a flake costs more than a break, and a suite
                         whose wall clock is stable is one whose regressions are visible.

                         reuseForks=true keeps it at four JVMs total rather than one per class; each
                         fork carries its own context cache, so the same configuration can boot twice
                         across forks. That is why the win is 25% and not 75%, and it is also why the
                         run stays correct: a fork's `jdbc:h2:mem:shio-test` is private to that JVM,
                         so classes sharing the default datasource get *more* isolation than before,
                         never less. Four green full runs before this landed.

                         Surefire only — failsafe is deliberately left at one fork. Its ten ITs start
                         Postgres and MariaDB containers, so their cost is container startup rather
                         than context boot, and parallelising them is a different measurement that
                         has not been taken. -->
                    <forkCount>4</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <!-- SH416 — was `true`, inherited from 81d65633 ("Using Maven") rather than
                         chosen, and it is half of why the cross-DB ITs were broken through a
                         release. The other half is `@Testcontainers(disabledWithoutDocker = true)`:
                         with no daemon these classes skip and read as a pass, and with one they
                         errored — but `testFailureIgnore` meant the error state was not red either,
                         so *neither* state of the machine told anybody. Now that SH415 makes the ITs
                         opt-in, the only person who sees them is one who typed `-DskipITs=false` to
                         get an answer, and returning green to that person is the one behaviour with
                         no defensible reading. -->
                    <testFailureIgnore>false</testFailureIgnore>
                    <!-- SH250 — the SH26 cross-database ITs boot the full context and mock
                         alongside it, so they need the same agent for the same reason surefire
                         does. Merged into the existing block rather than added as a second one:
                         two `configuration` elements on one plugin is a non-parseable POM. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.22.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.9.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pdf-plugin</artifactId>
                <version>1.6.2</version>
            </plugin>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>5.0.4</version>
                <configuration>
                    <propertyFile>liquibase.properties</propertyFile>
                    <diffChangeLogFile>src/main/resources/db/changelog/v2026.2_update.yaml</diffChangeLogFile>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>2.5.252</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
        </plugins>
    </reporting>
</project>
