    "console:thumbnail": "node e2e/site-thumbnail.check.mjs",
    "console:selection-bar": "node e2e/selection-bar.check.mjs",
    "test": "node --import ../scripts/test-watchdog.mjs --test \"test/*.test.mjs\""
  },
