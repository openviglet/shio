{
  "name": "@viglet/shio-react-sdk",
  "version": "2026.3.1",
  "description": "React SDK for consuming Shio CMS content via the Content Delivery API (CDA). Hooks + render components built on @viglet/shio-client.",
  "type": "module",
  "main": "dist/shio-react-sdk.umd.cjs",
  "module": "dist/shio-react-sdk.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shio-react-sdk.js",
      "require": "./dist/shio-react-sdk.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@viglet/shio-client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  },
  "keywords": [
    "shio",
    "cms",
    "headless",
    "react",
    "sdk",
    "cda"
  ],
  "author": "Viglet Team",
  "license": "GPL-3.0"
}
