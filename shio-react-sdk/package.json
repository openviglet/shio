{
  "name": "@viglet/shio-react-sdk",
  "version": "2026.3.2",
  "description": "React SDK for consuming Shio CMS content via the Content Delivery API (CDA). Hooks + render components built on @viglet/shio-client.",
  "homepage": "https://shio.viglet.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git",
    "directory": "shio-react-sdk"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "type": "module",
  "main": "dist/shio-react-sdk.umd.cjs",
  "module": "dist/shio-react-sdk.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shio-react-sdk.js",
      "require": "./dist/shio-react-sdk.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@viglet/shio-client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.2"
  },
  "keywords": [
    "shio",
    "viglet",
    "cms",
    "headless-cms",
    "content-management-system",
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "react",
    "sdk",
    "cda",
    "hooks",
    "nextjs",
    "typescript",
    "headless"
  ],
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  },
  "license": "Apache-2.0"
}
