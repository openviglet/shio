{
  "name": "@viglet/shio-editor-cors",
  "version": "2026.3.1",
  "description": "Shio CMS Universal Editor bridge - enables inline visual editing for any page",
  "type": "module",
  "main": "dist/shio-editor-cors.umd.cjs",
  "module": "dist/shio-editor-cors.js",
  "types": "dist/shio-editor-cors.d.ts",
  "exports": {
    ".": {
      "import": "./dist/shio-editor-cors.js",
      "require": "./dist/shio-editor-cors.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shio",
    "cms",
    "universal-editor",
    "visual-editing",
    "inline-editing"
  ],
  "author": "Viglet Team",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/viglet/shio.git",
    "directory": "shio-js-sdk"
  },
  "devDependencies": {
    "vite": "^8.1.0",
    "typescript": "^5.8.3"
  }
}
