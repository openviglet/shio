{
  "name": "@viglet/shio-editor-cors",
  "version": "2026.3.2",
  "description": "Viglet Shio Universal Editor bridge - enables inline visual editing for any page",
  "homepage": "https://openviglet.github.io/shio/",
  "type": "module",
  "main": "dist/shio-editor-cors.umd.cjs",
  "module": "dist/shio-editor-cors.js",
  "types": "dist/shio-editor-cors.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shio-editor-cors.d.ts",
      "import": "./dist/shio-editor-cors.js",
      "require": "./dist/shio-editor-cors.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shio",
    "viglet",
    "cms",
    "headless-cms",
    "content-management-system",
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "universal-editor",
    "visual-editing",
    "inline-editing",
    "wysiwyg",
    "live-preview",
    "headless"
  ],
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git",
    "directory": "shio-js-sdk"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "typescript": "^5.8.3"
  }
}
