{
  "name": "@viglet/create-shio-app",
  "version": "2026.3.2",
  "description": "Scaffold a Next.js (App Router) site wired to the Viglet Shio Content Delivery API. The flagship 'JS dev, zero Java' starter.",
  "homepage": "https://openviglet.github.io/shio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git",
    "directory": "create-shio-app"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "type": "module",
  "bin": {
    "create-shio-app": "src/index.mjs"
  },
  "exports": {
    "./scaffold": "./src/scaffold.mjs",
    "./published": "./src/published.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "template"
  ],
  "scripts": {
    "emit": "node src/emit.mjs",
    "test": "node --import ../scripts/test-watchdog.mjs --test \"test/*.test.mjs\"",
    "emit:check": "node scripts/emit-guard.mjs"
  },
  "keywords": [
    "shio",
    "viglet",
    "cms",
    "headless-cms",
    "content-management-system",
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "nextjs",
    "starter",
    "create",
    "scaffold",
    "react",
    "headless"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  },
  "license": "Apache-2.0"
}
