{
  "name": "@viglet/shio-model",
  "version": "2026.3.2",
  "description": "Typed TypeScript DSL for the Viglet Shio content model. Author post-types as code — `postType()`, `text()`, `comboBox()`, `relator()`, … — and compile to the canonical Shio post-type JSON that the `shio` CLI pushes. The authoring inverse of @viglet/shio-client's type generation. Zero runtime dependencies. (SH62)",
  "homepage": "https://shio.viglet.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openviglet/shio.git",
    "directory": "shio-model"
  },
  "bugs": {
    "url": "https://github.com/openviglet/shio/issues"
  },
  "type": "module",
  "main": "dist/shio-model.umd.cjs",
  "module": "dist/shio-model.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shio-model.js",
      "require": "./dist/shio-model.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../scripts/test-watchdog.mjs --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  },
  "keywords": [
    "shio",
    "viglet",
    "cms",
    "headless-cms",
    "content-management-system",
    "agent",
    "ai",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "post-types",
    "content-as-code",
    "dsl",
    "typescript",
    "gitops",
    "content-modeling",
    "headless"
  ],
  "author": {
    "name": "Viglet Team",
    "url": "https://www.viglet.org"
  },
  "license": "Apache-2.0"
}
